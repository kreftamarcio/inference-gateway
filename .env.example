# ═══════════════════════════════════════════════════════════════
# Inference Gateway — Environment Configuration
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ─── Provider API Keys ────────────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GROQ_API_KEY=gsk_...
GOOGLE_API_KEY=AIza...

# ─── Budget Limits (USD) ──────────────────────────────────────
BUDGET_DAILY=50.00
BUDGET_MONTHLY=1200.00
BUDGET_ALERT_THRESHOLD=0.8

# ─── Telemetry ────────────────────────────────────────────────
# OTLP-compatible endpoint (Jaeger, Tempo, Honeycomb, etc.)
OTEL_EXPORTER_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=inference-gateway

# ─── Server ───────────────────────────────────────────────────
NODE_ENV=development
PORT=3100
LOG_LEVEL=debug
